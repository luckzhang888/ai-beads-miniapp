page {
  min-height: 100%;
  background: #f8f7fb;
  color: #261f2e;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.container {
  box-sizing: border-box;
  padding: 28rpx;
}

.card {
  box-sizing: border-box;
  margin-bottom: 24rpx;
  padding: 28rpx;
  background: #ffffff;
  border: 1rpx solid #e8eaed;
  border-radius: 24rpx;
}

.title {
  font-size: 38rpx;
  font-weight: 700;
}

.subtitle {
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 26rpx;
  line-height: 1.55;
}

.primary-btn,
.secondary-btn {
  margin: 18rpx 0 0;
  border-radius: 18rpx;
  font-size: 30rpx;
}

.primary-btn {
  color: #ffffff;
  background: linear-gradient(135deg, #7b57e8, #6341d6);
  box-shadow: 0 10rpx 24rpx rgba(101, 67, 211, .22);
}

.secondary-btn {
  color: #1f2329;
  background: #eef2f7;
}

.muted {
  color: #8a919f;
}

.section-title {
  margin-bottom: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.badge {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #f1ecfb;
  color: #6847ce;
  font-size: 22rpx;
}

@media (min-width: 768px) {
  .container { padding: 24px; }
  .card { margin-bottom: 18px; padding: 20px; border-width: 1px; border-radius: 16px; }
  .title { font-size: 28px; }
  .subtitle { margin-top: 7px; font-size: 16px; }
  .section-title { margin-bottom: 13px; font-size: 20px; }
  .badge { padding: 3px 9px; font-size: 13px; }
  .primary-btn, .secondary-btn { margin-top: 13px; border-radius: 12px; font-size: 17px; }

  .warehouse-page,
  .library-page,
  .inspiration-page,
  .records-page,
  .profile-page {
    width: calc(100% - 184px);
    min-height: 100vh;
    margin-left: 184px;
    padding-left: clamp(24px, 4vw, 52px);
    padding-right: clamp(24px, 4vw, 52px);
  }

  .journey-page,
  .classify-page,
  .recognition-page,
  .config-page,
  .pdf-page,
  .detail-page {
    width: min(100%, 1080px);
    margin-left: auto;
    margin-right: auto;
    padding-left: clamp(28px, 5vw, 72px);
    padding-right: clamp(28px, 5vw, 72px);
  }
}
