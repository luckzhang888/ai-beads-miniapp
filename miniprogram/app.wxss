page {
  min-height: 100%;
  background: #f5f6f8;
  color: #1f2329;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
}

.container {
  box-sizing: border-box;
  padding: 28rpx;
}

.card {
  box-sizing: border-box;
  margin-bottom: 24rpx;
  padding: 28rpx;
  background: #ffffff;
  border: 1rpx solid #e8eaed;
  border-radius: 24rpx;
}

.title {
  font-size: 38rpx;
  font-weight: 700;
}

.subtitle {
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 26rpx;
  line-height: 1.55;
}

.primary-btn,
.secondary-btn {
  margin: 18rpx 0 0;
  border-radius: 18rpx;
  font-size: 30rpx;
}

.primary-btn {
  color: #ffffff;
  background: #2563eb;
}

.secondary-btn {
  color: #1f2329;
  background: #eef2f7;
}

.muted {
  color: #8a919f;
}

.section-title {
  margin-bottom: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.badge {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #4f46e5;
  font-size: 22rpx;
}
