.inspiration-page { min-height: 100vh; box-sizing: border-box; padding: 24rpx 24rpx 80rpx; background: radial-gradient(circle at 85% 0,rgba(215,207,250,.48),transparent 30%),#f8f8fc; }
.inspiration-hero { display: flex; align-items: center; justify-content: space-between; padding: 26rpx; border-radius: 26rpx; background: linear-gradient(135deg,#f0eaff,#e6f7f3); }
.hero-title { font-size: 36rpx; font-weight: 800; }
.hero-note { margin-top: 7rpx; color: #8c8494; font-size: 21rpx; }
.inspiration-hero button { margin: 0; color: white; border-radius: 18rpx; background: #6a4ad3; font-size: 21rpx; }
.search-box { height: 82rpx; margin: 22rpx 0; padding: 0 22rpx; display: flex; align-items: center; gap: 13rpx; border: 1rpx solid #ebe7ef; border-radius: 22rpx; background: white; }
.search-box input { flex: 1; }
.section-title { margin: 26rpx 3rpx 18rpx; font-size: 30rpx; font-weight: 800; }
.section-title text { float: right; color: #9a929f; font-size: 21rpx; font-weight: 400; }
.inspiration-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 18rpx; }
.inspiration-card { position: relative; min-width: 0; overflow: hidden; border: 1rpx solid #ebe7ef; border-radius: 24rpx; background: white; }
.preview { height: 300rpx; display: flex; align-items: center; justify-content: center; overflow: hidden; background: linear-gradient(145deg,#f5f0fc,#eef9f6); }
.collect-button { position: absolute; z-index: 3; right: 13rpx; top: 13rpx; width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #755ed0; background: rgba(255,255,255,.92); font-size: 30rpx; }
.collect-button.active { color: #f29e28; }
.card-name { overflow: hidden; padding: 17rpx 17rpx 5rpx; font-size: 25rpx; font-weight: 700; white-space: nowrap; text-overflow: ellipsis; }
.card-meta { padding: 0 17rpx 18rpx; color: #9a929f; font-size: 19rpx; }
.empty-state { padding: 120rpx 20rpx; display: flex; align-items: center; flex-direction: column; color: #9a929f; }
.empty-state view { color: #7254d8; font-size: 58rpx; }
.empty-state text { margin: 12rpx 0 25rpx; }
.empty-state button { color: white; border-radius: 18rpx; background: #694ad2; }

@media (min-width: 768px) {
  .inspiration-page { padding-top: 24px; padding-bottom: 48px; }
  .inspiration-hero { padding: 18px; border-radius: 18px; }
  .hero-title { font-size: 25px; }
  .hero-note { margin-top: 5px; font-size: 14px; }
  .inspiration-hero button { border-radius: 12px; font-size: 14px; }
  .search-box { height: 56px; margin: 16px 0; padding: 0 16px; gap: 9px; border-width: 1px; border-radius: 15px; }
  .search-box input { font-size: 15px; }
  .section-title { margin: 18px 2px 13px; font-size: 21px; }
  .section-title text { font-size: 14px; }
  .inspiration-grid { grid-template-columns: repeat(3,minmax(0,1fr)); gap: 20px; }
  .inspiration-card { border-width: 1px; border-radius: 16px; }
  .preview { height: 220px; }
  .collect-button { right: 10px; top: 10px; width: 38px; height: 38px; font-size: 21px; }
  .card-name { padding: 12px 12px 4px; font-size: 17px; }
  .card-meta { padding: 0 12px 13px; font-size: 13px; }
}
