.compact-card {
  padding: 22rpx;
}

.editor-head,
.palette-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.editor-title {
  margin-bottom: 4rpx;
}

.meta {
  color: #8a919f;
  font-size: 23rpx;
}

.save-btn {
  margin: 0;
  color: #ffffff;
  background: #2563eb;
}

.tools {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 20rpx;
}

.tools button {
  margin: 0;
}

.secondary-tools {
  margin-top: 12rpx;
}

.tool.active {
  color: #ffffff;
  background: #2563eb;
}

.zoom-text {
  min-width: 62rpx;
  color: #59606b;
  font-size: 24rpx;
  text-align: center;
}

.tip {
  margin: 18rpx 0 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: #f3f6fb;
  color: #59606b;
  font-size: 23rpx;
  line-height: 1.5;
}

.selected-chip,
.swatch {
  border: 1rpx solid rgba(0, 0, 0, 0.15);
}

.selected-chip {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
}

.color-actions { display: flex; flex-wrap: wrap; gap: 10rpx; margin: 18rpx 0; }
.color-actions button { margin: 0; color: #6044bd; background: #f0ecfb; }
.candidate-section { margin: 17rpx 0 20rpx; padding: 15rpx; border-radius: 17rpx; background: #f5f2f8; }
.candidate-scroll { margin-top: 11rpx; white-space: nowrap; }
.candidate-inner { display: inline-flex; gap: 10rpx; }
.candidate-chip { display: inline-grid; grid-template-columns: 36rpx auto; grid-template-rows: auto auto; column-gap: 8rpx; align-items: center; padding: 8rpx 13rpx; border-radius: 14rpx; background: white; font-size: 19rpx; }
.candidate-chip > view { grid-row: 1 / 3; width: 34rpx; height: 34rpx; border: 1rpx solid rgba(0,0,0,.1); border-radius: 9rpx; }
.candidate-chip text:last-child { color: #9b92a2; font-size: 16rpx; }

.palette-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
}

.palette-item {
  min-width: 0;
  padding: 12rpx 8rpx;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  background: #f7f8fa;
  text-align: center;
}

.palette-item.selected {
  border-color: #2563eb;
  background: #eff6ff;
}

.palette-item { position: relative; }
.lock-tag { position: absolute; top: 5rpx; right: 6rpx; color: #6545c6; font-size: 16rpx; }

.swatch {
  width: 52rpx;
  height: 52rpx;
  margin: 0 auto 6rpx;
  border-radius: 12rpx;
}

.palette-code {
  font-size: 22rpx;
  font-weight: 700;
}

.palette-name {
  overflow: hidden;
  margin-top: 2rpx;
  color: #8a919f;
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
