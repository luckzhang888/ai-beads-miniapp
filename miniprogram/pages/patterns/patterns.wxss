.header-row,
.pattern-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.header-row {
  margin-bottom: 24rpx;
}

.create-btn {
  margin: 4rpx 0 0;
  color: #ffffff;
  background: #2563eb;
}

.pattern-card {
  padding: 24rpx;
}

.pattern-main {
  min-width: 0;
  flex: 1;
}

.pattern-name {
  overflow: hidden;
  font-size: 29rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pattern-meta,
.pattern-time {
  margin-top: 8rpx;
  color: #8a919f;
  font-size: 22rpx;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 0 0 auto;
}

.actions button {
  margin: 0;
  font-size: 21rpx;
}

.actions .danger {
  color: #dc2626;
}

.empty {
  padding: 54rpx 30rpx;
  text-align: center;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
}
