<view class="library-page">
  <view class="brand-bar">
    <view class="brand">
      <view class="brand-mark">豆</view>
      <view><view class="brand-name">AI 豆仓</view><view class="brand-note">MARD 221 标准色</view></view>
    </view>
    <view class="inventory-link" bindtap="goInventory">◫ 豆仓</view>
  </view>

  <scroll-view scroll-x class="top-nav" enhanced show-scrollbar="false">
    <view class="top-nav-inner">
      <view class="nav-item" bindtap="goInventory">豆仓</view>
      <view class="nav-item active">图纸册</view>
      <view class="nav-item" data-name="灵感库" bindtap="showComingSoon">灵感库</view>
      <view class="nav-item" data-name="记录" bindtap="showComingSoon">记录</view>
      <view class="nav-item" data-name="我的" bindtap="showComingSoon">我的</view>
    </view>
  </scroll-view>

  <view class="summary-card">
    <view class="summary-item"><text>{{stats.folders}}</text><view>图纸夹</view></view>
    <view class="summary-line"></view>
    <view class="summary-item"><text>{{stats.working}}</text><view>正在拼</view></view>
    <view class="summary-line"></view>
    <view class="summary-item"><text>{{stats.pending}}</text><view>待拼图纸</view></view>
    <view class="summary-line"></view>
    <view class="summary-item"><text>{{stats.total}}</text><view>累计图纸</view></view>
  </view>

  <view class="search-box">
    <text class="search-icon">⌕</text>
    <input value="{{query}}" bindinput="onSearch" placeholder="搜索图纸或标签" />
    <text class="search-tool">⌘</text>
  </view>

  <scroll-view scroll-x class="filter-scroll" enhanced show-scrollbar="false">
    <view class="filter-inner">
      <view
        wx:for="{{statuses}}"
        wx:key="*this"
        class="filter-pill {{selectedStatus === item ? 'active' : ''}}"
        data-status="{{item}}"
        bindtap="selectStatus"
      >{{item}}</view>
    </view>
  </scroll-view>

  <view class="section-head"><view class="section-name">文件夹</view><view class="create-folder" data-name="文件夹" bindtap="showComingSoon">＋ 创建</view></view>
  <scroll-view scroll-x class="folder-scroll" enhanced show-scrollbar="false">
    <view class="folder-inner">
      <view class="folder-card" wx:for="{{folders}}" wx:key="id" data-id="{{item.cover.id}}" bindtap="openPattern">
        <view class="folder-count">{{item.count}} 图纸</view>
        <view class="folder-preview">
          <bead-grid matrix="{{item.cover.matrix}}" palette="{{paletteMap}}" compact="{{true}}" preview-size="{{146}}" show-grid="{{false}}" />
        </view>
        <view class="folder-name">{{item.title}}</view>
      </view>
    </view>
  </scroll-view>

  <view class="section-head"><view class="section-name">我的图纸</view><view class="section-count">{{visiblePatterns.length}} 张</view></view>
  <view wx:if="{{visiblePatterns.length}}" class="pattern-grid">
    <view class="pattern-card" wx:for="{{visiblePatterns}}" wx:key="id" data-id="{{item.id}}" bindtap="openPattern">
      <view class="status-badge {{item.status === '已拼' ? 'done' : ''}}">{{item.status}}</view>
      <view class="pattern-preview">
        <bead-grid matrix="{{item.matrix}}" palette="{{paletteMap}}" compact="{{true}}" preview-size="{{164}}" show-grid="{{false}}" />
      </view>
      <view class="pattern-copy">
        <view class="pattern-name">{{item.name}}</view>
        <view class="pattern-meta">◉ {{item.colorCount}}　◎ {{item.beadCount}}</view>
        <view class="pattern-meta">▦ {{item.width || item.size}}×{{item.height || item.size}} · {{item.displayTime}}</view>
      </view>
    </view>
  </view>
  <view wx:else class="empty-state">没有匹配的图纸，换个关键词试试。</view>

  <view class="safe-bottom"></view>
  <button class="upload-button" bindtap="goCreate">＋ 上传图纸</button>
</view>
