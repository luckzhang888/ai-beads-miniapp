.hero {
  padding-top: 34rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.quick-card {
  min-width: 0;
  padding: 24rpx;
}

.quick-title {
  font-size: 29rpx;
  font-weight: 700;
}

.quick-desc {
  margin-top: 10rpx;
  color: #7a828e;
  font-size: 22rpx;
  line-height: 1.5;
}

.quick-link {
  margin-top: 16rpx;
  color: #2563eb;
  font-size: 23rpx;
  font-weight: 600;
}

.recent-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.recent-head .section-title {
  margin-bottom: 0;
}

.all-link {
  color: #2563eb;
  font-size: 23rpx;
}

.pattern-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-top: 1rpx solid #eef0f2;
}

.pattern-item:first-of-type {
  margin-top: 14rpx;
}

.pattern-name {
  font-size: 29rpx;
  font-weight: 600;
}

.pattern-meta {
  margin-top: 6rpx;
  color: #8a919f;
  font-size: 24rpx;
}

.arrow {
  color: #a0a7b3;
  font-size: 46rpx;
}

.notice {
  padding: 8rpx 8rpx 32rpx;
  color: #8a919f;
  font-size: 23rpx;
  line-height: 1.55;
}

@media (min-width: 768px) {
  .hero { padding-top: 24px; }
  .quick-grid { gap: 13px; }
  .quick-card { padding: 17px; }
  .quick-title { font-size: 20px; }
  .quick-desc { margin-top: 7px; font-size: 15px; }
  .quick-link, .all-link { margin-top: 11px; font-size: 15px; }
  .pattern-item { padding: 15px 0; border-top-width: 1px; }
  .pattern-item:first-of-type { margin-top: 10px; }
  .pattern-name { font-size: 20px; }
  .pattern-meta { margin-top: 4px; font-size: 16px; }
  .arrow { font-size: 31px; }
  .notice { padding: 6px 6px 22px; font-size: 15px; }
}
