.hero {
  padding-top: 34rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.quick-card {
  min-width: 0;
  padding: 24rpx;
}

.quick-title {
  font-size: 29rpx;
  font-weight: 700;
}

.quick-desc {
  margin-top: 10rpx;
  color: #7a828e;
  font-size: 22rpx;
  line-height: 1.5;
}

.quick-link {
  margin-top: 16rpx;
  color: #2563eb;
  font-size: 23rpx;
  font-weight: 600;
}

.recent-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.recent-head .section-title {
  margin-bottom: 0;
}

.all-link {
  color: #2563eb;
  font-size: 23rpx;
}

.pattern-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-top: 1rpx solid #eef0f2;
}

.pattern-item:first-of-type {
  margin-top: 14rpx;
}

.pattern-name {
  font-size: 29rpx;
  font-weight: 600;
}

.pattern-meta {
  margin-top: 6rpx;
  color: #8a919f;
  font-size: 24rpx;
}

.arrow {
  color: #a0a7b3;
  font-size: 46rpx;
}

.notice {
  padding: 8rpx 8rpx 32rpx;
  color: #8a919f;
  font-size: 23rpx;
  line-height: 1.55;
}
