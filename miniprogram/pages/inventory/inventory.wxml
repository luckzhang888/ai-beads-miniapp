<view class="warehouse-page">
  <view class="warehouse-header">
    <view>
      <view class="warehouse-title">我的豆仓</view>
      <view class="warehouse-subtitle">MARD 221 标准色库存</view>
    </view>
  </view>

  <scroll-view class="brand-scroll" scroll-x enhanced show-scrollbar="false">
    <view class="brand-tabs">
      <view wx:for="{{brandOptions}}" wx:key="*this" class="brand-tab {{activeBrand === item ? 'active' : ''}}" data-brand="{{item}}" bindtap="selectBrand">{{item}} 色卡</view>
    </view>
  </scroll-view>

  <view class="summary-row">
    <view class="summary-label">总库存</view>
    <view class="summary-pill">
      <text class="summary-number">{{totalStock}}</text>
      <text class="summary-unit"> 粒 · </text>
      <text class="summary-number">{{colorCount}}</text>
      <text class="summary-unit"> 色号</text>
    </view>
    <view class="low-pill" bindtap="toggleLowOnly">⚠ {{lowCount}} 不足 {{showLowOnly ? '· 仅看不足' : ''}}</view>
  </view>

  <view class="inventory-quick-actions four">
    <view class="quick-action" bindtap="showShortageList">缺豆清单 <text>{{shortageCount}}</text></view>
    <view class="quick-action" bindtap="openConsumptionCalculator">消耗计算</view>
    <view class="quick-action" data-tab="batch" data-direction="1" bindtap="openStockEntry">补豆入库</view>
    <view class="quick-action" bindtap="setLowStockThreshold">低库存阈值 <text>{{lowStock}}</text></view>
  </view>

  <view class="search-wrap">
    <text class="search-icon">⌕</text>
    <input
      class="search-input"
      placeholder="搜索色号，例如 A18、M12"
      value="{{query}}"
      bindinput="onSearchInput"
    />
  </view>

  <scroll-view class="series-scroll" scroll-x enhanced show-scrollbar="false">
    <view class="series-tabs">
      <view
        wx:for="{{seriesOptions}}"
        wx:key="*this"
        class="{{activeSeries === item ? 'series-tab active' : 'series-tab'}}"
        data-series="{{item}}"
        bindtap="selectSeries"
      >{{item === 'ALL' ? '全部' : item}}</view>
    </view>
  </scroll-view>

  <view class="toolbar">
    <view class="sort-options">
      <view class="{{sortMode === 'default' ? 'tool-pill active' : 'tool-pill'}}" data-sort="default" bindtap="setSort">↕ 默认</view>
      <view class="{{sortMode === 'asc' ? 'tool-pill active' : 'tool-pill'}}" data-sort="asc" bindtap="setSort">由少到多</view>
      <view class="{{sortMode === 'desc' ? 'tool-pill active' : 'tool-pill'}}" data-sort="desc" bindtap="setSort">由多到少</view>
    </view>
    <view class="view-switch">
      <view class="{{viewMode === 'series' ? 'view-button active' : 'view-button'}}" data-view="series" bindtap="setView">☷</view>
      <view class="{{viewMode === 'grid' ? 'view-button active' : 'view-button'}}" data-view="grid" bindtap="setView">▦</view>
    </view>
  </view>

  <view wx:if="{{viewMode === 'series'}}" class="series-list">
    <view class="series-block" wx:for="{{groups}}" wx:key="series">
      <view class="series-header" data-series="{{item.series}}" bindtap="toggleSeries">
        <view class="series-name">{{item.series}}系列</view>
        <view class="series-meta">{{item.colorCount}} 色号 · {{item.totalStock}} 粒　{{item.expanded ? '⌄' : '›'}}</view>
      </view>

      <view wx:if="{{item.expanded}}" class="stock-grid">
        <view class="stock-card" wx:for="{{item.items}}" wx:key="code" wx:for-item="color">
          <view class="stock-card-top">
            <text class="stock-code">{{color.code}}</text>
            <text class="{{color.low ? 'status low' : 'status'}}">{{color.low ? '库存不足' : '库存充足'}}</text>
          </view>
          <view class="color-panel" style="background: {{color.hex}};">
            <input
              class="stock-value"
              type="number"
              value="{{color.stock}}"
              data-code="{{color.code}}"
              bindblur="setExactStock"
            />
            <text class="stock-unit">粒</text>
          </view>
          <view class="mini-actions">
            <view data-code="{{color.code}}" data-delta="-10" bindtap="adjust">-10</view>
            <view data-code="{{color.code}}" data-delta="10" bindtap="adjust">+10</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="color-grid">
    <view class="color-tile" wx:for="{{rows}}" wx:key="code">
      <view class="tile-color" style="background: {{item.hex}};">
        <text class="tile-code">{{item.code}}</text>
      </view>
      <input
        class="tile-stock"
        type="number"
        value="{{item.stock}}"
        data-code="{{item.code}}"
        bindblur="setExactStock"
      />
    </view>
  </view>

  <view wx:if="{{transactions.length}}" class="transaction-section">
    <view class="transaction-title">最近库存记录</view>
    <view class="transaction-row" wx:for="{{transactions}}" wx:key="id">
      <view><view class="transaction-name">{{item.typeLabel}}{{item.patternName ? ' · ' + item.patternName : ''}}</view><view class="transaction-meta">{{item.itemCount}} 个色号 · {{item.timeLabel}}</view></view>
      <button wx:if="{{!item.undone}}" size="mini" data-id="{{item.id}}" bindtap="undoStockTransaction">撤销</button>
      <text wx:else class="undone-label">已撤销</text>
    </view>
  </view>

  <view class="page-note">库存按品牌隔离保存；当前已接入 MARD 221 色，新增品牌色卡后可直接扩展。</view>

  <view wx:if="{{showStockEntry}}" class="full-mask">
    <view class="stock-entry-page">
      <view class="entry-header"><view class="back-link" bindtap="closeStockEntry">‹ 返回</view><view class="entry-title">补豆入库</view><view class="ai-label">✦ 智能录入</view></view>
      <scroll-view scroll-x class="entry-tabs" enhanced show-scrollbar="false">
        <view class="entry-tab-row">
          <view class="entry-tab {{entryTab === 'batch' ? 'active' : ''}}" data-tab="batch" bindtap="selectEntryTab">批量记录</view>
          <view class="entry-tab {{entryTab === 'manual' ? 'active' : ''}}" data-tab="manual" bindtap="selectEntryTab">手动记录</view>
          <view class="entry-tab {{entryTab === 'csv' ? 'active' : ''}}" data-tab="csv" bindtap="selectEntryTab">导入文件</view>
          <view class="entry-tab {{entryTab === 'package' ? 'active' : ''}}" data-tab="package" bindtap="selectEntryTab">套装入库</view>
        </view>
      </scroll-view>
      <view class="direction-card">
        <view><view class="entry-card-title">库存调整方向</view><view class="entry-card-note">所有操作都可在库存记录中撤销</view></view>
        <view class="direction-switch"><view class="{{entryDirection > 0 ? 'active' : ''}}" data-direction="1" bindtap="selectEntryDirection">增加</view><view class="{{entryDirection < 0 ? 'danger' : ''}}" data-direction="-1" bindtap="selectEntryDirection">减少</view></view>
      </view>

      <scroll-view class="entry-content" scroll-y enhanced show-scrollbar="false">
        <view wx:if="{{entryTab === 'batch'}}" class="batch-entry">
          <view class="batch-summary">
            <view><text>{{batchSelectedCount}}</text><text>已填写色号</text></view>
            <view><text>{{batchTotalAmount}}</text><text>合计豆数</text></view>
          </view>
          <view class="entry-card batch-card">
            <view class="batch-card-head"><view class="entry-card-title">逐色号批量录入</view><view class="batch-clear" bindtap="clearBatchEntries">清空</view></view>
            <scroll-view scroll-x class="batch-series-scroll" enhanced show-scrollbar="false">
              <view class="batch-series-row"><view wx:for="{{seriesOptions}}" wx:key="*this" class="batch-series-pill {{batchSeries === item ? 'active' : ''}}" data-series="{{item}}" bindtap="selectBatchSeries">{{item === 'ALL' ? '全部' : item}}</view></view>
            </scroll-view>
            <view class="batch-list">
              <view class="batch-row" wx:for="{{batchRows}}" wx:key="code">
                <view class="batch-code"><text style="background: {{item.hex}};"></text>{{item.code}}</view>
                <input type="number" placeholder="数量" value="{{item.amount}}" data-code="{{item.code}}" bindinput="inputBatchAmount" />
                <view class="batch-preset" data-code="{{item.code}}" data-amount="500" bindtap="quickBatchAmount">+500</view>
                <view class="batch-preset" data-code="{{item.code}}" data-amount="1000" bindtap="quickBatchAmount">+1000</view>
                <view class="batch-preset" data-code="{{item.code}}" data-amount="1200" bindtap="quickBatchAmount">+1200</view>
              </view>
            </view>
          </view>
        </view>

        <view wx:elif="{{entryTab === 'manual'}}" class="entry-card manual-card">
          <view class="entry-card-title">逐个录入色号</view>
          <view class="manual-row" wx:for="{{entryRows}}" wx:key="index">
            <view class="remove-row" data-index="{{index}}" bindtap="removeEntryRow">－</view>
            <input placeholder="色号" value="{{item.code}}" data-index="{{index}}" data-field="code" bindinput="inputEntryRow" />
            <input type="number" placeholder="数量" value="{{item.amount}}" data-index="{{index}}" data-field="amount" bindinput="inputEntryRow" />
            <view class="row-preset" data-index="{{index}}" data-amount="1000" bindtap="quickEntryRow">1000</view>
            <view class="row-preset" data-index="{{index}}" data-amount="1200" bindtap="quickEntryRow">1200</view>
          </view>
          <view class="add-row" bindtap="addEntryRow">＋ 添加一行</view>
        </view>

        <view wx:elif="{{entryTab === 'csv'}}" class="entry-card upload-card">
          <view class="upload-icon">⇧</view><view class="entry-card-title">上传 CSV 格式文件</view><view class="entry-card-note">第一列为色号，第二列为数量；支持 CSV/TXT</view>
          <view wx:if="{{csvFileName}}" class="file-preview"><text>{{csvFileName}}</text><text>{{csvItems.length}} 个有效色号</text></view>
          <view class="upload-actions"><button bindtap="downloadCsvTemplate">获取模板</button><button class="primary" bindtap="chooseCsvFile">选择文件</button></view>
        </view>

        <view wx:else class="entry-card">
          <view class="entry-card-title">选择套装</view>
          <view class="package-grid"><view wx:for="{{packageOptions}}" wx:key="*this" class="package-pill {{selectedPackage === item ? 'active' : ''}}" data-count="{{item}}" bindtap="selectPackage">{{item}}{{item === 221 ? ' 全实色' : ' 色'}}</view></view>
          <view class="package-amount"><text>每色数量</text><input type="number" value="{{packageAmount}}" bindinput="inputPackageAmount" /></view>
        </view>
        <view class="entry-bottom-space"></view>
      </scroll-view>
      <view class="entry-footer"><button bindtap="confirmStockEntry">确认{{entryDirection > 0 ? '入库' : '减少库存'}}</button></view>
    </view>
  </view>

  <view wx:if="{{showShortageSheet}}" class="sheet-mask" bindtap="closeShortageSheet">
    <view class="bottom-sheet shortage-sheet" catchtap="noop">
      <view class="sheet-handle"></view><view class="sheet-title">补豆清单</view><view class="sheet-subtitle">{{shortagePatternName}}</view>
      <view class="refill-summary"><view><text>{{shortageRows.length}}</text><text> 需补色号</text></view><label>补后目标<input type="number" value="{{refillTarget}}" bindblur="inputRefillTarget" />粒</label></view>
      <view class="unit-row"><text>最少补豆单位</text><view class="unit-options"><view class="{{refillUnit === 500 ? 'active' : ''}}" data-unit="500" bindtap="setRefillUnit">500</view><view class="{{refillUnit === 1000 ? 'active' : ''}}" data-unit="1000" bindtap="setRefillUnit">1000</view></view></view>
      <scroll-view class="shortage-list" scroll-y enhanced show-scrollbar="false">
        <view class="shortage-head"><text>色号</text><text>使用后库存</text><text>补豆数量</text></view>
        <view class="shortage-row" wx:for="{{shortageRows}}" wx:key="code"><view><text class="color-dot" style="background: {{item.hex}};"></text>{{item.code}}</view><text class="{{item.afterUse < 0 ? 'negative' : ''}}">{{item.afterUse}}</text><text class="refill-number">{{item.refill}}</text></view>
        <view wx:if="{{!shortageRows.length}}" class="empty-shortage">库存已达到目标，无需补豆。</view>
      </scroll-view>
      <view class="copy-actions"><button data-mode="codes" bindtap="copyShortage">复制色号</button><button data-mode="stock" bindtap="copyShortage">复制库存</button><button class="primary" data-mode="refill" bindtap="copyShortage">复制补豆清单</button></view>
    </view>
  </view>

  <view wx:if="{{showConsumptionSheet}}" class="full-mask">
    <view class="consumption-page">
      <view class="entry-header"><view class="back-link" bindtap="closeConsumptionSheet">‹ 返回</view><view class="entry-title">消耗计算</view><view></view></view>
      <view class="consumption-count">已选 {{selectedConsumptionIds.length}} 张 · 可同时计算多张图纸</view>
      <scroll-view class="consumption-list" scroll-y enhanced show-scrollbar="false">
        <view class="consumption-row {{item.selected ? 'selected' : ''}}" wx:for="{{consumptionPatterns}}" wx:key="id" data-id="{{item.id}}" bindtap="toggleConsumptionPattern"><view class="select-box">{{item.selected ? '✓' : ''}}</view><view class="pattern-thumb">▦</view><view class="consumption-copy"><view>{{item.name}}</view><text>{{item.colorCount}} 色 · {{item.beadCount}} 粒 · {{item.width}}×{{item.height}}</text></view></view>
        <view wx:if="{{!consumptionPatterns.length}}" class="empty-shortage">还没有图纸，请先导入图纸。</view>
      </scroll-view>
      <view class="consumption-footer"><button bindtap="selectAllConsumption">一键全选</button><button class="primary" bindtap="calculateConsumption">立即计算</button></view>
    </view>
  </view>
</view>
