.warehouse-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx 80rpx;
  background: linear-gradient(180deg, #ffffff 0, #f3f6ff 360rpx, #f8f9fc 100%);
}

.warehouse-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 12rpx 0 26rpx;
}

.warehouse-title {
  font-size: 42rpx;
  font-weight: 800;
  color: #15171c;
}

.warehouse-subtitle {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8d93a1;
}

.summary-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.brand-scroll { margin-bottom: 18rpx; white-space: nowrap; }
.brand-tabs { display: inline-flex; gap: 12rpx; }
.brand-tab { padding: 11rpx 20rpx; border: 1rpx solid #dcd7ea; border-radius: 999rpx; color: #776e82; background: white; font-size: 22rpx; }
.brand-tab.active { color: white; border-color: #6755ea; background: #6755ea; }
.inventory-quick-actions { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 11rpx; margin-bottom: 20rpx; }
.inventory-quick-actions.four { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.quick-action { padding: 16rpx 8rpx; border: 1rpx solid #e1ddeb; border-radius: 16rpx; color: #655c6e; background: white; text-align: center; font-size: 21rpx; }
.quick-action text { color: #684bd0; font-weight: 750; }
.quick-action.active { color: white; border-color: #6755ea; background: #6755ea; }

.summary-label {
  font-size: 28rpx;
  font-weight: 700;
}

.summary-pill,
.low-pill {
  padding: 14rpx 22rpx;
  border: 1rpx solid #e2e4ec;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 8rpx 24rpx rgba(80, 91, 135, 0.05);
}

.summary-pill {
  flex: 1;
}

.summary-number {
  font-size: 29rpx;
  font-weight: 700;
}

.summary-unit {
  color: #8b909b;
  font-size: 22rpx;
}

.low-pill {
  color: #df941d;
  font-size: 23rpx;
  white-space: nowrap;
}

.search-wrap {
  display: flex;
  align-items: center;
  height: 84rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e5e8ef;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.94);
}

.search-icon {
  margin-right: 14rpx;
  color: #858b96;
  font-size: 40rpx;
}

.search-input {
  flex: 1;
  font-size: 27rpx;
}

.series-scroll {
  width: 100%;
  margin-top: 22rpx;
  white-space: nowrap;
}

.series-tabs {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 20rpx;
}

.series-tab {
  min-width: 58rpx;
  padding: 13rpx 18rpx;
  border: 1rpx solid #e0e3eb;
  border-radius: 30rpx;
  background: #fff;
  text-align: center;
  color: #20232a;
  font-size: 25rpx;
}

.series-tab.active,
.tool-pill.active,
.view-button.active {
  border-color: #6755ea;
  background: #6755ea;
  color: #fff;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 18rpx 0 24rpx;
}

.sort-options,
.view-switch {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.tool-pill {
  padding: 13rpx 18rpx;
  border: 1rpx solid #e0e3eb;
  border-radius: 28rpx;
  background: #fff;
  font-size: 23rpx;
}

.view-switch {
  padding: 5rpx;
  border: 1rpx solid #e0e3eb;
  border-radius: 30rpx;
  background: #fff;
}

.view-button {
  min-width: 46rpx;
  padding: 8rpx 10rpx;
  border-radius: 23rpx;
  text-align: center;
  color: #a2a6af;
}

.series-block {
  margin-bottom: 10rpx;
}

.series-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  padding: 0 8rpx;
}

.series-name {
  font-size: 31rpx;
  font-weight: 700;
}

.series-meta {
  color: #8f949d;
  font-size: 24rpx;
}

.stock-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  padding-bottom: 16rpx;
}

.stock-card {
  overflow: hidden;
  padding: 18rpx;
  border: 1rpx solid #e4e6ed;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.96);
}

.stock-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.stock-code {
  font-size: 29rpx;
  font-weight: 750;
}

.status {
  padding: 5rpx 10rpx;
  border: 1rpx solid #aee8d1;
  border-radius: 18rpx;
  color: #2ca97a;
  font-size: 18rpx;
}

.status.low {
  border-color: #f4c984;
  color: #d78d17;
}

.color-panel {
  display: flex;
  align-items: baseline;
  min-height: 92rpx;
  padding: 12rpx 16rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  border-radius: 14rpx;
}

.stock-value {
  width: 78%;
  font-size: 43rpx;
  font-weight: 700;
  color: #1f1f23;
}

.stock-unit {
  margin-left: 4rpx;
  color: rgba(0, 0, 0, 0.56);
  font-size: 21rpx;
}

.mini-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10rpx;
  margin-top: 12rpx;
}

.mini-actions view {
  padding: 6rpx 14rpx;
  border-radius: 18rpx;
  background: #f1efff;
  color: #5f4dd8;
  font-size: 20rpx;
}

.color-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 18rpx 14rpx;
}

.color-tile {
  min-width: 0;
  text-align: center;
}

.tile-color {
  display: flex;
  height: 116rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(0, 0, 0, 0.07);
  border-radius: 15rpx;
}

.tile-code {
  padding: 2rpx 6rpx;
  color: #28282c;
  font-size: 28rpx;
  font-weight: 700;
  text-shadow: 0 1rpx 2rpx rgba(255, 255, 255, 0.75);
}

.tile-stock {
  width: 100%;
  height: 42rpx;
  text-align: center;
  color: #858b96;
  font-size: 23rpx;
}

.page-note {
  margin-top: 30rpx;
  text-align: center;
  color: #a1a5ae;
  font-size: 20rpx;
}

.transaction-section { margin-top: 32rpx; padding: 22rpx; border: 1rpx solid #e3e4eb; border-radius: 22rpx; background: white; }
.transaction-title { margin-bottom: 12rpx; font-size: 28rpx; font-weight: 750; }
.transaction-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 15rpx 0; border-top: 1rpx solid #f0eef3; }
.transaction-row button { margin: 0; color: #6547c8; background: #f0ebfb; }
.transaction-name { font-size: 23rpx; font-weight: 650; }
.transaction-meta { margin-top: 5rpx; color: #9991a1; font-size: 18rpx; }
.undone-label { color: #aaa3b0; font-size: 19rpx; }

.full-mask { position: fixed; z-index: 50; left: 0; right: 0; top: 0; bottom: 0; background: #f4f6ff; }
.stock-entry-page, .consumption-page { height: 100%; display: flex; flex-direction: column; background: linear-gradient(180deg, #fff 0, #f2f5ff 360rpx, #f7f9ff); }
.entry-header { height: 110rpx; padding: 0 30rpx; display: grid; grid-template-columns: 1fr 1fr 1fr; align-items: center; border-bottom: 1rpx solid #e7e5eb; background: white; }
.back-link { color: #6650df; font-size: 27rpx; }
.entry-title { text-align: center; font-size: 34rpx; font-weight: 800; white-space: nowrap; }
.ai-label { justify-self: end; padding: 10rpx 16rpx; border: 2rpx solid #6d53e2; border-radius: 999rpx; color: #624bcf; font-size: 20rpx; white-space: nowrap; }
.entry-tabs { flex: none; margin: 20rpx 28rpx 0; border-radius: 22rpx; background: #ebeafd; white-space: nowrap; }
.entry-tab-row { min-width: 100%; display: inline-flex; }
.entry-tab { min-width: 178rpx; padding: 21rpx 23rpx; box-sizing: border-box; border-radius: 20rpx; color: #9892a0; text-align: center; font-size: 23rpx; }
.entry-tab.active { color: #15151a; background: white; box-shadow: 0 6rpx 18rpx rgba(78,61,120,.09); font-weight: 700; }
.direction-card { margin: 20rpx 28rpx 0; padding: 21rpx 24rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; border-radius: 22rpx; background: white; }
.entry-card-title { font-size: 27rpx; font-weight: 750; }
.entry-card-note { margin-top: 5rpx; color: #a19ba9; font-size: 19rpx; }
.direction-switch { display: flex; padding: 5rpx; border-radius: 999rpx; background: #f1eff7; }
.direction-switch view { padding: 11rpx 24rpx; border-radius: 999rpx; color: #aaa3b2; font-size: 21rpx; }
.direction-switch view.active { color: white; background: #6850df; }
.direction-switch view.danger { color: white; background: #ef6172; }
.entry-content { flex: 1; min-height: 0; box-sizing: border-box; padding: 20rpx 28rpx 0; }
.entry-card { padding: 27rpx; border-radius: 24rpx; background: white; }
.package-pill { padding: 12rpx 20rpx; border: 1rpx solid #dedbe5; border-radius: 999rpx; color: #605968; background: white; font-size: 22rpx; }
.package-pill.active { color: white; border-color: #6b50df; background: #6b50df; }
.manual-card { padding-top: 12rpx; }
.manual-card > .entry-card-title { padding: 15rpx 0 20rpx; }
.manual-row { min-height: 104rpx; display: grid; grid-template-columns: 44rpx 1fr 1fr 86rpx 86rpx; align-items: center; gap: 9rpx; border-top: 1rpx solid #ebe8ef; }
.manual-row input { min-width: 0; height: 62rpx; padding: 0 13rpx; box-sizing: border-box; border: 1rpx solid #e5e2eb; border-radius: 13rpx; background: #faf9fc; font-size: 23rpx; }
.remove-row { width: 38rpx; height: 38rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: white; background: #ff4651; }
.row-preset { padding: 14rpx 5rpx; border-radius: 12rpx; color: #644bd2; background: #f2effb; text-align: center; font-size: 20rpx; }
.add-row { padding: 22rpx 0 8rpx; color: #654bd7; font-size: 26rpx; }
.upload-card { padding: 70rpx 26rpx; border: 2rpx dashed #d1ccd9; text-align: center; }
.upload-icon { width: 96rpx; height: 96rpx; margin: 0 auto 20rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #6750dc; background: #eeebff; font-size: 48rpx; }
.file-preview { margin: 25rpx auto 0; padding: 17rpx; display: flex; justify-content: space-between; gap: 15rpx; border-radius: 14rpx; color: #605969; background: #f5f3fa; font-size: 20rpx; }
.upload-actions { margin-top: 27rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.upload-actions button { width: 100%; margin: 0; color: #654bd7; background: white; border: 2rpx solid #7256dd; }
.upload-actions button.primary { color: white; background: #684fde; }
.package-grid { margin-top: 22rpx; display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 14rpx; }
.package-pill { border-radius: 16rpx; text-align: center; }
.package-amount { margin-top: 30rpx; padding: 18rpx; display: flex; align-items: center; justify-content: space-between; border-radius: 18rpx; background: #f8f7fb; }
.package-amount input { width: 180rpx; height: 62rpx; border: 1rpx solid #e1deea; border-radius: 13rpx; background: white; text-align: center; font-size: 27rpx; }
.entry-bottom-space { height: 40rpx; }
.entry-footer { flex: none; padding: 17rpx 28rpx calc(17rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e6e3eb; background: white; }
.entry-footer button { width: 100%; margin: 0; color: white; border-radius: 20rpx; background: #654be0; }

.sheet-mask { position: fixed; z-index: 55; left: 0; right: 0; top: 0; bottom: 0; display: flex; align-items: flex-end; background: rgba(27,24,33,.45); }
.bottom-sheet { width: 100%; max-height: 88vh; padding: 16rpx 28rpx calc(22rpx + env(safe-area-inset-bottom)); box-sizing: border-box; border-radius: 34rpx 34rpx 0 0; background: white; }
.sheet-handle { width: 76rpx; height: 8rpx; margin: 0 auto 15rpx; border-radius: 999rpx; background: #ddd8e3; }
.sheet-title { text-align: center; font-size: 34rpx; font-weight: 800; }
.sheet-subtitle { margin-top: 7rpx; overflow: hidden; color: #98919e; text-align: center; font-size: 21rpx; white-space: nowrap; text-overflow: ellipsis; }
.refill-summary { margin-top: 23rpx; padding: 20rpx; display: flex; align-items: center; justify-content: space-between; border-radius: 20rpx; background: linear-gradient(90deg,#fbf9ff,#f0fbfd); }
.refill-summary > view text:first-child { color: #e7444a; font-size: 34rpx; font-weight: 800; }
.refill-summary > view text:last-child { color: #a39ca9; font-size: 20rpx; }
.refill-summary label { display: flex; align-items: center; color: #77707e; font-size: 20rpx; }
.refill-summary input { width: 110rpx; margin: 0 8rpx; color: #6047cf; text-align: center; font-size: 28rpx; font-weight: 750; }
.unit-row { padding: 20rpx 0; display: flex; align-items: center; justify-content: space-between; }
.unit-options { display: flex; padding: 4rpx; border-radius: 999rpx; background: #f1eef7; }
.unit-options view { padding: 10rpx 22rpx; border-radius: 999rpx; color: #aaa3b0; }
.unit-options view.active { color: #6348d2; background: #ddd6fa; }
.shortage-list { height: 650rpx; border-top: 1rpx solid #e8e5ec; }
.shortage-head, .shortage-row { display: grid; grid-template-columns: 1.2fr 1fr 1fr; align-items: center; min-height: 72rpx; border-bottom: 1rpx solid #ece9ef; }
.shortage-head { color: #aaa3b0; font-size: 20rpx; }
.shortage-head text:nth-child(n+2), .shortage-row > text { text-align: right; }
.shortage-row { font-size: 24rpx; }
.shortage-row > view { display: flex; align-items: center; font-weight: 700; }
.color-dot { width: 27rpx; height: 27rpx; margin-right: 13rpx; border: 1rpx solid #d4d0d8; border-radius: 50%; }
.negative { color: #ee434d; }
.refill-number { color: #6248d2; font-weight: 750; }
.empty-shortage { padding: 80rpx 20rpx; color: #aaa3b0; text-align: center; }
.copy-actions { display: grid; grid-template-columns: 1fr 1fr 1.4fr; gap: 12rpx; margin-top: 19rpx; }
.copy-actions button { width: 100%; margin: 0; color: #664bd4; background: white; border: 2rpx solid #7356df; font-size: 21rpx; }
.copy-actions button.primary { color: white; background: #684fdf; }

.consumption-count { padding: 19rpx 28rpx; color: #6950d6; background: #efecff; text-align: center; font-size: 22rpx; }
.consumption-list { flex: 1; min-height: 0; }
.consumption-row { min-height: 136rpx; padding: 18rpx 28rpx; display: grid; grid-template-columns: 52rpx 92rpx minmax(0,1fr); align-items: center; gap: 17rpx; box-sizing: border-box; border-bottom: 1rpx solid #dedfe7; background: rgba(255,255,255,.45); }
.consumption-row.selected { background: #f2efff; }
.select-box { width: 43rpx; height: 43rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 3rpx solid #cbc9d1; border-radius: 50%; color: white; }
.consumption-row.selected .select-box { border-color: #694fdf; background: #694fdf; }
.pattern-thumb { width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; border-radius: 17rpx; color: #6d52d8; background: linear-gradient(145deg,#e2daf9,#dff5ee); font-size: 37rpx; }
.consumption-copy { min-width: 0; }
.consumption-copy view { overflow: hidden; font-size: 27rpx; font-weight: 700; white-space: nowrap; text-overflow: ellipsis; }
.consumption-copy text { display: block; margin-top: 8rpx; color: #9a94a0; font-size: 20rpx; }
.consumption-footer { padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); display: grid; grid-template-columns: 1fr 2fr; gap: 16rpx; border-top: 1rpx solid #e3e1e8; background: white; }
.consumption-footer button { width: 100%; margin: 0; color: #654bd5; border: 2rpx solid #7154df; background: white; }
.consumption-footer button.primary { color: white; background: #674cdf; }

@media (max-width: 390px) {
  .warehouse-header { align-items: flex-start; }
  .inventory-quick-actions.four { grid-template-columns: repeat(2, minmax(0,1fr)); }
  .manual-row { grid-template-columns: 40rpx 1fr 1fr; padding: 12rpx 0; }
  .manual-row .row-preset { display: none; }
}
