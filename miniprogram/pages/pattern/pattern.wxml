<view wx:if="{{pattern}}" class="assistant-page">
  <scroll-view scroll-x class="tool-scroll" enhanced show-scrollbar="false">
    <view class="tool-inner">
      <view class="tool-item active" bindtap="resetView"><text>▦</text><view>电子图纸</view></view>
      <view class="tool-item {{majorGrid ? 'active' : ''}}" bindtap="toggleGrid"><text>╬</text><view>辅助线</view></view>
      <view class="tool-item {{mirrored ? 'active' : ''}}" bindtap="toggleMirror"><text>⇆</text><view>镜像</view></view>
      <view class="tool-item {{showCodes ? 'active' : ''}}" bindtap="toggleCodes"><text>A1</text><view>色号</view></view>
      <view class="tool-item {{locked ? 'active' : ''}}" bindtap="toggleLock"><text>{{locked ? '●' : '○'}}</text><view>锁定</view></view>
      <view class="tool-item {{working ? 'active' : ''}}" bindtap="chooseProgressTool"><text>✓</text><view>{{progressToolName}}</view></view>
      <view class="tool-item" bindtap="previewExport"><text>⇩</text><view>导出</view></view>
      <view class="tool-item" bindtap="goEditor"><text>◉</text><view>色号整理</view></view>
      <view class="tool-item" bindtap="openSettings"><text>⚙</text><view>设置</view></view>
    </view>
  </scroll-view>

  <view class="progress-bar">
    <view class="progress-copy"><text>{{pattern.name}}</text><text class="progress-number">{{progress}}% 完成</text></view>
    <view class="progress-track"><view class="progress-fill" style="width: {{progress}}%;"></view></view>
  </view>

  <view class="canvas-shell">
    <view wx:if="{{majorGrid}}" class="axis-x"><text wx:for="{{axisX}}" wx:key="key" style="left: {{item.percent}}%;">{{item.label}}</text></view>
    <view wx:if="{{majorGrid}}" class="axis-y"><text wx:for="{{axisY}}" wx:key="key" style="top: {{item.percent}}%;">{{item.label}}</text></view>
    <bead-grid
      id="patternGrid"
      matrix="{{displayMatrix}}"
      palette="{{paletteMap}}"
      zoom="{{zoom}}"
      show-codes="{{showCodes}}"
      show-grid="{{showGrid}}"
      major-grid="{{majorGrid}}"
      highlight-code="{{highlightCode}}"
      locked="{{locked}}"
      max-zoom="{{6}}"
      completed-indices="{{displayCompletedIndices}}"
      scroll-left="{{scrollLeft}}"
      scroll-top="{{scrollTop}}"
      interactive="{{true}}"
      bind:celltap="handleCellTap"
      bind:zoomchange="handleZoomChange"
      bind:viewchange="handleViewChange"
    />
  </view>

  <view class="performance-hint" wx:if="{{performanceHint}}">{{performanceHint}}</view>
  <view class="gesture-hint">{{working ? progressToolName + '标记模式 · 点击图纸记录进度' : '双指缩放 · 单指拖动 · 放大后显示色号'}}</view>
  <view class="zoom-control"><view bindtap="zoomIn">＋</view><text>{{zoom}}×</text><view bindtap="zoomOut">－</view></view>
  <button class="work-button" bindtap="toggleWorking">{{workButtonText}}</button>

  <view class="palette-dock">
    <scroll-view scroll-x class="palette-scroll" enhanced show-scrollbar="false">
      <view class="palette-inner">
        <view class="palette-all {{!highlightCode ? 'active' : ''}}" data-code="" bindtap="selectColor">全部</view>
        <view
          class="palette-item {{highlightCode === item.code ? 'active' : ''}} {{item.completed ? 'completed' : ''}}"
          wx:for="{{stats}}"
          wx:key="code"
          data-code="{{item.code}}"
          bindtap="selectColor"
        >
          <view class="palette-color" style="background: {{item.hex}};"><text>{{item.completed ? '✓' : item.code}}</text></view>
          <view class="palette-count">{{item.required}}</view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
