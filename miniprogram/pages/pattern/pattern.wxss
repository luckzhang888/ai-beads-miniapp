.assistant-page { height: 100vh; overflow: hidden; background: #d9d4dc; }
.tool-scroll { position: relative; z-index: 8; height: 103rpx; white-space: nowrap; background: rgba(43,37,49,.92); }
.tool-inner { display: inline-flex; align-items: center; height: 103rpx; padding: 0 17rpx; }
.tool-item { width: 87rpx; height: 79rpx; margin-right: 8rpx; display: inline-flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 16rpx; color: #c8c1cc; }
.tool-item text { font-size: 27rpx; font-weight: 700; }
.tool-item view { margin-top: 4rpx; font-size: 17rpx; }
.tool-item.active { color: white; background: linear-gradient(145deg, #218bb0, #2aabd0); }
.progress-bar { height: 77rpx; padding: 10rpx 23rpx; box-sizing: border-box; background: white; }
.progress-copy { display: flex; align-items: center; justify-content: space-between; }
.progress-copy > text:first-child { max-width: 70%; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-weight: 700; }
.progress-number { color: #7b5ad7; font-size: 19rpx; }
.progress-track { height: 7rpx; margin-top: 9rpx; overflow: hidden; border-radius: 999rpx; background: #eee9f2; }
.progress-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg, #8d69ea, #55ceb1); transition: width .3s ease; }
.canvas-shell { position: relative; height: calc(100vh - 103rpx - 77rpx - 154rpx - env(safe-area-inset-bottom)); display: flex; align-items: flex-start; justify-content: center; padding-top: 32rpx; box-sizing: border-box; overflow: hidden; }
.axis-x { position: absolute; z-index: 6; left: 27rpx; right: 27rpx; top: 2rpx; height: 27rpx; color: #706a73; font-size: 16rpx; pointer-events: none; }
.axis-x text { position: absolute; top: 4rpx; transform: translateX(-50%); }
.axis-y { position: absolute; z-index: 6; left: 1rpx; top: 43rpx; bottom: 13rpx; width: 28rpx; color: #706a73; font-size: 16rpx; pointer-events: none; }
.axis-y text { position: absolute; left: 4rpx; transform: translateY(-50%); }
.gesture-hint { position: fixed; z-index: 12; left: 50%; bottom: calc(256rpx + env(safe-area-inset-bottom)); padding: 8rpx 17rpx; transform: translateX(-50%); border-radius: 999rpx; color: #736a7a; background: rgba(255,255,255,.86); box-shadow: 0 5rpx 16rpx rgba(48,38,56,.1); font-size: 18rpx; white-space: nowrap; pointer-events: none; }
.performance-hint { position: fixed; z-index: 12; left: 50%; top: 194rpx; max-width: 86%; padding: 8rpx 15rpx; transform: translateX(-50%); border-radius: 999rpx; color: #735b20; background: rgba(255,244,207,.94); font-size: 17rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.zoom-control { position: fixed; z-index: 12; left: 18rpx; bottom: calc(176rpx + env(safe-area-inset-bottom)); display: grid; grid-template-columns: 65rpx 65rpx 65rpx; height: 65rpx; overflow: hidden; border: 1rpx solid #d8d1df; border-radius: 20rpx; background: rgba(255,255,255,.94); box-shadow: 0 8rpx 24rpx rgba(48,38,56,.16); }
.zoom-control view, .zoom-control text { display: flex; align-items: center; justify-content: center; }
.zoom-control view { color: #6443c8; font-size: 31rpx; }
.zoom-control text { color: #918899; border-left: 1rpx solid #e5e0e8; border-right: 1rpx solid #e5e0e8; font-size: 19rpx; }
.work-button { position: fixed; z-index: 12; left: 50%; bottom: calc(172rpx + env(safe-area-inset-bottom)); width: 276rpx; height: 73rpx; margin: 0; padding: 0; transform: translateX(-50%); border: 0; border-radius: 22rpx; color: white; background: linear-gradient(135deg, #7b57e8, #6341d6); box-shadow: 0 12rpx 28rpx rgba(101,67,211,.3); font-size: 24rpx; }
.work-button::after { border: 0; }
.palette-dock { position: fixed; z-index: 11; left: 0; right: 0; bottom: 0; height: calc(154rpx + env(safe-area-inset-bottom)); padding: 15rpx 0 env(safe-area-inset-bottom); box-sizing: border-box; border-top: 1rpx solid #e4dfe8; background: rgba(255,255,255,.96); backdrop-filter: blur(20rpx); }
.palette-scroll { height: 122rpx; white-space: nowrap; }
.palette-inner { display: inline-flex; align-items: center; height: 122rpx; padding-left: 17rpx; }
.palette-all { width: 75rpx; height: 75rpx; margin-right: 13rpx; display: inline-flex; align-items: center; justify-content: center; border: 3rpx solid #7454d5; border-radius: 50%; box-sizing: border-box; color: #6443c7; font-size: 19rpx; }
.palette-all.active { color: white; background: #704dde; }
.palette-item { width: 79rpx; margin-right: 11rpx; display: inline-flex; flex-direction: column; align-items: center; vertical-align: top; opacity: .88; }
.palette-color { width: 67rpx; height: 67rpx; display: flex; align-items: center; justify-content: center; border: 4rpx solid white; border-radius: 50%; box-sizing: border-box; color: #27232c; text-shadow: 0 1rpx 2rpx white; box-shadow: 0 4rpx 12rpx rgba(47,37,55,.15); font-size: 16rpx; font-weight: 750; }
.palette-count { margin-top: 5rpx; color: #877f8e; font-size: 17rpx; }
.palette-item.active .palette-color { border-color: #744fdb; transform: translateY(-5rpx) scale(1.08); box-shadow: 0 7rpx 20rpx rgba(103,68,208,.3); }
.palette-item.completed { opacity: .42; }
