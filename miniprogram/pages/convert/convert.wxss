.step-title {
  margin-bottom: 22rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.image-box {
  overflow: hidden;
  width: 100%;
  height: 420rpx;
  border: 2rpx dashed #d7dbe2;
  border-radius: 20rpx;
  background: #f8f9fb;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.image-placeholder {
  display: flex;
  height: 100%;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  color: #8a919f;
  font-size: 26rpx;
}

.plus {
  margin-bottom: 10rpx;
  color: #5d6470;
  font-size: 62rpx;
  line-height: 1;
}

.size-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.size-item {
  box-sizing: border-box;
  padding: 24rpx 12rpx;
  border: 2rpx solid #e1e4e8;
  border-radius: 16rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}

.size-item.active {
  border-color: #2563eb;
  background: #eff6ff;
  color: #1d4ed8;
}

.hint {
  margin-top: 16rpx;
  color: #8a919f;
  font-size: 23rpx;
  line-height: 1.5;
}

.palette-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.palette-name {
  font-size: 28rpx;
  font-weight: 600;
}

.generate-btn {
  margin-bottom: 42rpx;
}
