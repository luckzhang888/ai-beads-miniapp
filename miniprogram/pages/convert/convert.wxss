.journey-page,
.pdf-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx;
  color: #261f2e;
  background: radial-gradient(circle at 50% 0, rgba(216, 207, 250, .48), transparent 34%), #f8f7fb;
}

.journey-head,
.config-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.journey-head { padding: 20rpx 8rpx 34rpx; }
.import-mode-tabs { margin: -12rpx 0 24rpx; padding: 8rpx; display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 7rpx; border-radius: 22rpx; background: #eeebfb; }
.import-mode-tabs view { padding: 18rpx 8rpx; border-radius: 17rpx; text-align: center; font-size: 23rpx; font-weight: 650; }
.import-mode-tabs view:first-child { color: #6243c8; background: white; box-shadow: 0 5rpx 14rpx rgba(77,55,116,.08); }
.journey-title, .config-title { font-size: 39rpx; font-weight: 800; }
.journey-note, .config-note { margin-top: 9rpx; color: #948b9e; font-size: 23rpx; }
.journey-orb { width: 75rpx; height: 75rpx; display: flex; align-items: center; justify-content: center; border-radius: 23rpx; color: #6949d1; background: linear-gradient(145deg, #e4dbfb, #cff1e9); font-size: 33rpx; }
.method-card { display: flex; align-items: center; min-height: 124rpx; margin-bottom: 17rpx; padding: 18rpx 20rpx; box-sizing: border-box; border: 1rpx solid #ddd6e6; border-radius: 24rpx; background: rgba(255,255,255,.94); box-shadow: 0 10rpx 28rpx rgba(73,56,97,.06); }
.method-icon { width: 69rpx; height: 69rpx; flex: none; display: flex; align-items: center; justify-content: center; margin-right: 19rpx; border-radius: 20rpx; color: #6c48d4; background: #f1ecfc; font-size: 31rpx; font-weight: 800; }
.method-copy { flex: 1; min-width: 0; }
.method-title-row { display: flex; align-items: center; }
.method-title { font-size: 28rpx; font-weight: 700; }
.method-badge { margin-left: 11rpx; padding: 4rpx 10rpx; border-radius: 999rpx; color: #6847cf; background: #eee8fc; font-size: 17rpx; }
.method-description { margin-top: 8rpx; color: #9a929f; font-size: 20rpx; line-height: 1.5; }
.method-arrow { color: #b5adbd; font-size: 41rpx; }
.config-page { background: radial-gradient(circle at 80% 0, rgba(218, 208, 251, .32), transparent 26%), #f7f6fa; }
.config-head { padding: 3rpx 2rpx 23rpx; }
.config-actions { display: flex; align-items: center; gap: 11rpx; }
.batch-import { padding: 10rpx 14rpx; border: 1rpx solid #6d4dd7; border-radius: 999rpx; color: #6546c9; background: #f2edff; font-size: 19rpx; white-space: nowrap; }
.back-methods { padding: 11rpx 18rpx; border: 1rpx solid #cbbbea; border-radius: 999rpx; color: #6847ce; font-size: 21rpx; }

.step-title {
  margin-bottom: 22rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.image-box {
  overflow: hidden;
  width: 100%;
  height: 420rpx;
  border: 2rpx dashed #d7dbe2;
  border-radius: 20rpx;
  background: #f8f9fb;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.crop-stage { position: relative; touch-action: none; }
.crop-image { transition: transform .05s linear; transform-origin: center; }
.crop-frame { position: absolute; z-index: 3; left: 10rpx; right: 10rpx; top: 10rpx; bottom: 10rpx; display: flex; align-items: flex-start; justify-content: flex-end; padding: 10rpx; border: 2rpx dashed rgba(255,255,255,.94); box-sizing: border-box; box-shadow: inset 0 0 0 1rpx rgba(42,31,54,.16); pointer-events: none; }
.crop-frame text { padding: 5rpx 10rpx; border-radius: 999rpx; color: white; background: rgba(37,29,44,.58); font-size: 17rpx; }
.crop-toolbar { display: flex; justify-content: center; gap: 14rpx; margin-top: 15rpx; }
.crop-toolbar view { padding: 10rpx 17rpx; border-radius: 999rpx; color: #6443c8; background: #f0ebfb; font-size: 21rpx; }

.image-placeholder {
  display: flex;
  height: 100%;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  color: #8a919f;
  font-size: 26rpx;
}

.plus {
  margin-bottom: 10rpx;
  color: #5d6470;
  font-size: 62rpx;
  line-height: 1;
}

.option-label {
  margin-bottom: 12rpx;
  color: #59606b;
  font-size: 24rpx;
  font-weight: 600;
}

.option-space {
  margin-top: 24rpx;
}

.choice-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.choice-row.three {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.choice {
  padding: 20rpx 10rpx;
  border: 2rpx solid #e1e4e8;
  border-radius: 16rpx;
  text-align: center;
  font-size: 25rpx;
}

.choice.active {
  border-color: #7352d7;
  background: #f1ecfb;
  color: #6040c1;
  font-weight: 600;
}

.recommend {
  margin: -6rpx 0 16rpx;
  color: #16803a;
  font-size: 23rpx;
  font-weight: 600;
}

.size-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.size-item {
  position: relative;
  box-sizing: border-box;
  padding: 24rpx 12rpx;
  border: 2rpx solid #e1e4e8;
  border-radius: 16rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}

.size-item.active {
  border-color: #7352d7;
  background: #f1ecfb;
  color: #6040c1;
}

.recommend-tag {
  display: inline-block;
  margin-left: 8rpx;
  padding: 2rpx 8rpx;
  border-radius: 999rpx;
  background: #ecfdf3;
  color: #16803a;
  font-size: 18rpx;
  vertical-align: middle;
}

.hint {
  margin-top: 16rpx;
  color: #8a919f;
  font-size: 23rpx;
  line-height: 1.5;
}

.palette-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.palette-name {
  font-size: 28rpx;
  font-weight: 600;
}

.generate-btn {
  margin-bottom: 42rpx;
  background: linear-gradient(135deg, #7b57e8, #6341d6);
  box-shadow: 0 12rpx 28rpx rgba(101, 67, 211, .26);
}
.batch-progress { position: fixed; z-index: 45; left: 50%; bottom: calc(120rpx + env(safe-area-inset-bottom)); padding: 13rpx 24rpx; transform: translateX(-50%); border-radius: 999rpx; color: white; background: rgba(56,43,75,.88); font-size: 21rpx; white-space: nowrap; }

.compact-hint { margin-top: 5rpx; }
.background-row, .preview-head, .preview-summary { display: flex; align-items: center; justify-content: space-between; }
.background-title { font-size: 25rpx; font-weight: 650; }
.threshold-row { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 7rpx; margin-top: 15rpx; color: #8a8193; font-size: 18rpx; }
.threshold-row slider { margin: 0; }
.preview-head .step-title { margin-bottom: 0; }
.preview-head button { margin: 0; color: #6242c5; background: #eee9fa; }
.pixel-preview { margin-top: 22rpx; display: flex; flex-direction: column; align-items: center; }
.preview-summary { width: 100%; margin-top: 17rpx; padding: 17rpx 20rpx; border-radius: 17rpx; box-sizing: border-box; color: #6e6577; background: #f4f1f7; font-size: 21rpx; }
.preview-empty { margin-top: 20rpx; padding: 45rpx 20rpx; border: 1rpx dashed #ddd4e8; border-radius: 18rpx; color: #9b92a4; text-align: center; }

.pdf-page { display: flex; align-items: flex-start; justify-content: center; }
.pdf-card { width: 100%; margin-top: 90rpx; padding: 34rpx; box-sizing: border-box; border-radius: 28rpx; background: white; text-align: center; box-shadow: 0 14rpx 40rpx rgba(72, 53, 96, .09); }
.pdf-icon { width: 110rpx; height: 110rpx; margin: 8rpx auto 23rpx; display: flex; align-items: center; justify-content: center; border-radius: 28rpx; color: white; background: linear-gradient(145deg, #8260e5, #6041c5); font-weight: 800; }
.pdf-name { font-size: 30rpx; font-weight: 700; word-break: break-all; }
.pdf-size { margin-top: 8rpx; color: #a197a8; font-size: 21rpx; }
.pdf-note { margin: 27rpx 0; padding: 21rpx; border-radius: 18rpx; color: #756c7e; background: #f5f1fa; text-align: left; line-height: 1.65; font-size: 22rpx; }
.dialog-mask { position: fixed; z-index: 50; left: 0; right: 0; top: 0; bottom: 0; display: flex; align-items: center; justify-content: center; padding: 40rpx; background: rgba(35,28,42,.45); backdrop-filter: blur(10rpx); }
.share-dialog { width: 100%; padding: 33rpx; border-radius: 28rpx; background: white; box-sizing: border-box; }
.share-title { font-size: 33rpx; font-weight: 800; }
.share-note { margin-top: 9rpx; color: #958c9e; font-size: 22rpx; }
.share-input { height: 87rpx; margin: 27rpx 0; padding: 0 21rpx; border: 1rpx solid #e4ddec; border-radius: 18rpx; background: #f6f3f8; }
.dialog-actions { display: flex; gap: 17rpx; }
.dialog-actions button { flex: 1; height: 81rpx; margin: 0; }
.dialog-actions .primary-btn { background: linear-gradient(135deg, #7b57e8, #6341d6); }
.dialog-actions button::after { border: 0; }
.link-boundary { margin: -12rpx 0 20rpx; padding: 14rpx 16rpx; border-radius: 14rpx; color: #8b7480; background: #fff5f6; font-size: 19rpx; line-height: 1.5; }

.classify-page, .recognition-page { min-height: 100vh; box-sizing: border-box; padding: 28rpx; color: #251f2c; background: linear-gradient(180deg,#f4f1ff,#eef8fb); }
.classify-card { margin-top: 45rpx; padding: 30rpx; border-radius: 30rpx; background: white; box-shadow: 0 16rpx 45rpx rgba(69,53,92,.10); }
.classify-title { text-align: center; font-size: 34rpx; font-weight: 800; }
.classify-note { margin-top: 8rpx; color: #9a929f; text-align: center; font-size: 21rpx; }
.classify-preview { height: 660rpx; margin: 26rpx 0; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 22rpx; background-color: #f4f4f4; background-image: linear-gradient(45deg,#e7e7e7 25%,transparent 25%),linear-gradient(-45deg,#e7e7e7 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#e7e7e7 75%),linear-gradient(-45deg,transparent 75%,#e7e7e7 75%); background-size: 30rpx 30rpx; background-position: 0 0,0 15rpx,15rpx -15rpx,-15rpx 0; }
.classify-preview image { width: 100%; height: 100%; }
.variant-row { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 14rpx; }
.variant-item { padding: 19rpx 8rpx; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 8rpx; border: 2rpx solid #d8d4dc; border-radius: 19rpx; font-size: 23rpx; }
.variant-item view { color: #a49ca9; font-size: 31rpx; }
.variant-item.active { color: #6545cb; border-color: #6d4ed6; background: #f1edfc; }
.variant-item.active view { color: #6d4ed6; }
.classify-confirm { margin-top: 24rpx; }
.recognition-title { padding: 10rpx 0 24rpx; text-align: center; font-size: 36rpx; font-weight: 800; }
.recognition-preview { min-height: 660rpx; display: flex; align-items: center; justify-content: center; overflow: hidden; border: 14rpx solid white; border-radius: 30rpx; background: #f3f0f6; box-shadow: 0 12rpx 35rpx rgba(68,52,91,.09); }
.recognition-preview image { width: 100%; height: 660rpx; }
.recognition-summary { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 17rpx; margin-top: 20rpx; }
.recognition-summary view { padding: 22rpx; display: flex; align-items: center; justify-content: space-between; border-radius: 22rpx; background: white; }
.recognition-summary text { color: #aaa2ae; font-size: 20rpx; }
.recognition-summary b { font-size: 25rpx; }
.recognition-progress-card { margin-top: 20rpx; padding: 25rpx; border-radius: 25rpx; background: white; }
.recognition-steps { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 11rpx; }
.recognition-steps text { padding-top: 12rpx; border-top: 6rpx solid #ddd8e2; color: #817887; text-align: center; font-size: 19rpx; }
.recognition-steps text.done { border-color: #37c96a; color: #28212e; }
.recognition-step { margin: 24rpx 0 14rpx; display: flex; justify-content: space-between; }
.recognition-step b { font-size: 25rpx; }
.recognition-step text { color: #684ad2; font-size: 26rpx; font-weight: 800; }
.recognition-actions { display: grid; grid-template-columns: 1fr 1.8fr; gap: 14rpx; margin-top: 22rpx; padding-bottom: calc(28rpx + env(safe-area-inset-bottom)); }
.recognition-actions button { width: 100%; margin: 0; border-radius: 20rpx; color: #6548ca; background: white; }
.recognition-actions button.primary { color: white; background: linear-gradient(135deg,#7b57e8,#6341d6); }
.recognition-warning { margin-top: 16rpx; padding: 17rpx 20rpx; border: 1rpx solid #f0d39a; border-radius: 17rpx; color: #8a6014; background: #fff8e8; font-size: 21rpx; }

@media (min-width: 768px) {
  .journey-page { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); column-gap: 20px; }
  .journey-head, .import-mode-tabs { grid-column: 1 / -1; }
  .classify-preview, .recognition-preview, .recognition-preview image { height: 620px; min-height: 0; }
  .share-dialog { max-width: 620px; }
}
