<view class="container">
  <view class="card">
    <view class="step-title">1. 选择图片</view>

    <view class="image-box" bindtap="chooseImage">
      <image
        wx:if="{{imagePath}}"
        class="preview-image"
        src="{{imagePath}}"
        mode="{{imageMode}}"
      />
      <view wx:else class="image-placeholder">
        <view class="plus">＋</view>
        <view>从相册或相机选择图片</view>
      </view>
    </view>

    <button class="secondary-btn" bindtap="chooseImage">
      {{imagePath ? '重新选择图片' : '选择图片'}}
    </button>
  </view>

  <view class="card">
    <view class="step-title">2. 图片处理方式</view>
    <view class="option-label">构图</view>
    <view class="choice-row">
      <view class="{{cropMode == 'cover' ? 'choice active' : 'choice'}}" data-mode="cover" bindtap="selectCrop">居中裁剪</view>
      <view class="{{cropMode == 'contain' ? 'choice active' : 'choice'}}" data-mode="contain" bindtap="selectCrop">完整保留</view>
    </view>
    <view class="hint">居中裁剪会铺满正方形；完整保留会用白色填充空白区域。</view>

    <view class="option-label option-space">图像优化</view>
    <view class="choice-row three">
      <view
        wx:for="{{optimizeOptions}}"
        wx:key="value"
        class="{{optimizePreset == item.value ? 'choice active' : 'choice'}}"
        data-preset="{{item.value}}"
        bindtap="selectOptimize"
      >{{item.label}}</view>
    </view>
    <view class="hint">增强会略微提高对比度和饱和度，更适合轮廓明显的拼豆图。</view>
  </view>

  <view class="card">
    <view class="step-title">3. 选择拼豆尺寸</view>
    <view class="recommend" wx:if="{{imagePath}}">自动推荐：{{recommendedSize}}×{{recommendedSize}}</view>
    <view class="size-list">
      <view
        wx:for="{{sizes}}"
        wx:key="*this"
        class="{{selectedSize == item ? 'size-item active' : 'size-item'}}"
        data-size="{{item}}"
        bindtap="selectSize"
      >
        {{item}}×{{item}}
        <view class="recommend-tag" wx:if="{{recommendedSize == item}}">推荐</view>
      </view>
    </view>
    <view class="hint">尺寸越大细节越多，同时处理和制作需要的拼豆数量也越多。</view>
  </view>

  <view class="card">
    <view class="step-title">4. MARD 色卡</view>
    <view class="palette-row">
      <view>
        <view class="palette-name">{{paletteName}}</view>
        <view class="hint">A/B/C/D/E/F/G/H/M 共 221 色，生成后可直接用于豆仓库存统计。</view>
      </view>
      <view class="badge">Lab / ΔE2000</view>
    </view>
  </view>

  <button
    class="primary-btn generate-btn"
    loading="{{generating}}"
    disabled="{{generating}}"
    bindtap="generatePattern"
  >
    {{generating ? '正在匹配 MARD 色号…' : '生成 MARD 拼豆图纸'}}
  </button>
</view>
