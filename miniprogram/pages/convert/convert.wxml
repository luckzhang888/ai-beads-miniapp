<view wx:if="{{stage === 'methods'}}" class="journey-page">
  <view class="journey-head">
    <view><view class="journey-title">开始创作之旅</view><view class="journey-note">选择一种导入方式，我们会自动整理色号</view></view>
    <view class="journey-orb">✦</view>
  </view>
  <view
    class="method-card"
    wx:for="{{methods}}"
    wx:key="id"
    data-id="{{item.id}}"
    bindtap="selectMethod"
  >
    <view class="method-icon">{{item.icon}}</view>
    <view class="method-copy">
      <view class="method-title-row"><text class="method-title">{{item.title}}</text><text wx:if="{{item.badge}}" class="method-badge">{{item.badge}}</text></view>
      <view class="method-description">{{item.description}}</view>
    </view>
    <view class="method-arrow">›</view>
  </view>
</view>

<view wx:elif="{{stage === 'config'}}" class="container config-page">
  <view class="config-head"><view><view class="config-title">{{selectedMethodTitle || '图纸导入'}}</view><view class="config-note">使用 MARD 221 标准色与 CIEDE2000 匹配</view></view><view class="config-actions"><view class="batch-import" bindtap="chooseBatchImages">▧ 批量导入</view><view class="back-methods" bindtap="resetMethods">更换方式</view></view></view>
  <view class="card">
    <view class="step-title">1. 选择图片</view>
    <view
      class="image-box crop-stage"
      bindtouchstart="cropTouchStart"
      catchtouchmove="cropTouchMove"
      bindtouchend="cropTouchEnd"
      bindtouchcancel="cropTouchEnd"
    >
      <image wx:if="{{imagePath}}" class="preview-image crop-image" src="{{imagePath}}" mode="{{imageMode}}" style="{{cropStyle}}" />
      <view class="crop-frame" wx:if="{{imagePath}}"><text>{{outputWidth}} × {{outputHeight}}</text></view>
      <view wx:else class="image-placeholder" bindtap="chooseImage">
        <view class="plus">＋</view>
        <view>从相册或相机选择图片</view>
      </view>
    </view>
    <button class="secondary-btn" bindtap="chooseImage">{{imagePath ? '重新选择图片' : '选择图片'}}</button>
    <view wx:if="{{imagePath}}" class="crop-toolbar">
      <view bindtap="rotateCrop">↻ 旋转</view>
      <view bindtap="toggleCropMirror">⇆ 镜像</view>
      <view bindtap="resetCrop">重置构图</view>
    </view>
    <view wx:if="{{imagePath}}" class="hint">在图片上单指移动、双指缩放；虚线框就是最终生成区域。</view>
  </view>

  <view class="card">
    <view class="step-title">2. 构图与照片优化</view>
    <view class="option-label">构图</view>
    <view class="choice-row three">
      <view class="{{cropMode == 'ratio' ? 'choice active' : 'choice'}}" data-mode="ratio" bindtap="selectCrop">保持比例</view>
      <view class="{{cropMode == 'cover' ? 'choice active' : 'choice'}}" data-mode="cover" bindtap="selectCrop">方形裁剪</view>
      <view class="{{cropMode == 'contain' ? 'choice active' : 'choice'}}" data-mode="contain" bindtap="selectCrop">方形留白</view>
    </view>
    <view class="hint">照片默认保持原始宽高比，避免竖图人物被裁掉。</view>

    <view class="option-label option-space">图像优化</view>
    <view class="choice-row">
      <view wx:for="{{optimizeOptions}}" wx:key="value" class="{{optimizePreset == item.value ? 'choice active' : 'choice'}}" data-preset="{{item.value}}" bindtap="selectOptimize">{{item.label}}</view>
    </view>
    <view class="hint">“照片优化”会适度提亮暗部，让深色头发、盔甲等细节更容易映射到拼豆色。</view>

    <view class="option-label option-space">空白背景</view>
    <view class="background-row">
      <view><view class="background-title">去除透明/近白背景</view><view class="hint compact-hint">空白格不计入豆数和库存</view></view>
      <switch checked="{{removeBackground}}" bindchange="toggleBackgroundRemoval" color="#7150d8" />
    </view>
    <view wx:if="{{removeBackground}}" class="threshold-row">
      <text>去白更强</text>
      <slider min="220" max="255" step="5" value="{{whiteThreshold}}" bindchange="changeWhiteThreshold" activeColor="#7150d8" block-size="18" />
      <text>保留更多白色</text>
    </view>
  </view>

  <view class="card">
    <view class="step-title">3. 选择图纸精度</view>
    <view class="recommend" wx:if="{{imagePath}}">自动推荐短边：{{recommendedSize}}，预计图纸：{{outputWidth}}×{{outputHeight}}</view>
    <view class="size-list">
      <view wx:for="{{sizes}}" wx:key="*this" class="{{selectedSize == item ? 'size-item active' : 'size-item'}}" data-size="{{item}}" bindtap="selectSize">
        短边 {{item}}
        <view class="recommend-tag" wx:if="{{recommendedSize == item}}">推荐</view>
      </view>
    </view>
    <view class="hint">例如竖版 800×1172 照片，短边 80 会生成约 80×117，而不是强制裁成 80×80。</view>
  </view>

  <view class="card">
    <view class="step-title">4. 出图策略</view>
    <view class="choice-row">
      <view wx:for="{{qualityOptions}}" wx:key="value" class="{{qualityMode == item.value ? 'choice active' : 'choice'}}" data-mode="{{item.value}}" bindtap="selectQuality">
        {{item.label}} · {{item.hint}}
      </view>
    </view>
    <view class="hint">平衡模式会限制零碎色并清理孤立豆点；高还原保留更多颜色；易制作优先减少色号。</view>
  </view>

  <view class="card">
    <view class="step-title">5. 色卡</view>
    <view class="palette-row">
      <view>
        <view class="palette-name">{{paletteName}}</view>
        <view class="hint">MARD 基础系列 A/B/C/D/E/F/G/H/M，共 221 色。</view>
      </view>
      <view class="badge">Lab / ΔE2000</view>
    </view>
  </view>

  <view class="card preview-card">
    <view class="preview-head"><view><view class="step-title">6. 生成前预览</view><view class="hint compact-hint">先检查空白、色号数量和构图，再保存图纸。</view></view><button size="mini" loading="{{previewing}}" bindtap="previewPattern">刷新预览</button></view>
    <view wx:if="{{previewResult}}" class="pixel-preview">
      <bead-grid matrix="{{previewResult.matrix}}" palette="{{paletteMap}}" compact="{{true}}" preview-size="{{300}}" show-grid="{{true}}" />
      <view class="preview-summary">
        <text>{{previewResult.width}}×{{previewResult.height}}</text>
        <text>{{previewResult.usedColorCount}} 色</text>
        <text>{{previewResult.blankCount}} 空白格</text>
      </view>
    </view>
    <view wx:else class="preview-empty">点击“刷新预览”查看转换结果</view>
  </view>

  <button class="primary-btn generate-btn" loading="{{generating}}" disabled="{{generating}}" bindtap="generatePattern">
    {{generating ? '正在生成…' : '生成拼豆图纸'}}
  </button>
  <view wx:if="{{batchImporting}}" class="batch-progress">{{batchProgress}}</view>
</view>

<view wx:elif="{{stage === 'pdf'}}" class="pdf-page">
  <view class="pdf-card">
    <view class="pdf-icon">PDF</view>
    <view class="pdf-name">{{pdfFile.name}}</view>
    <view class="pdf-size">已选择 {{pdfFile.size}} 字节</view>
    <view class="pdf-note">PDF 导入已完成文件选择入口。微信小程序端无法直接栅格化 PDF，正式识别需要接入安全的服务端转换接口。</view>
    <button class="primary-btn" bindtap="previewPdf">预览 PDF</button>
    <button class="secondary-btn" bindtap="resetMethods">返回导入方式</button>
  </view>
</view>

<view wx:if="{{showShareDialog}}" class="dialog-mask" bindtap="closeShareDialog">
  <view class="share-dialog" catchtap="noop">
    <view class="share-title">分享口令导入</view>
    <view class="share-note">输入以 DC1- 开头的图纸口令</view>
    <input class="share-input" value="{{shareCode}}" bindinput="onShareInput" placeholder="例如 DC1-pattern-123" />
    <view class="dialog-actions">
      <button class="secondary-btn" bindtap="closeShareDialog">取消</button>
      <button class="primary-btn" bindtap="importShareCode">立即导入</button>
    </view>
  </view>
</view>
