<scroll-view
  class="grid-scroll"
  scroll-x
  scroll-y
  enhanced
  show-scrollbar="{{false}}"
  style="height: {{viewportHeight}}px; width: {{viewportSize}}px;"
>
  <canvas
    id="beadCanvas"
    type="2d"
    bindtap="handleTap"
    style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"
  />
</scroll-view>
