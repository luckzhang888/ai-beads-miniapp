<scroll-view
  class="grid-scroll {{compact ? 'compact' : ''}}"
  scroll-x="{{!compact && !locked}}"
  scroll-y="{{!compact && !locked}}"
  enhanced
  show-scrollbar="{{false}}"
  style="height: {{viewportHeight}}px; width: {{viewportSize}}px;"
>
  <canvas
    id="beadCanvas"
    type="2d"
    bindtap="handleTap"
    style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"
  />
</scroll-view>
