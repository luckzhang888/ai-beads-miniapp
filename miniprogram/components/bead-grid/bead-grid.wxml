<scroll-view
  class="grid-scroll {{compact ? 'compact' : ''}}"
  scroll-x="{{!compact && !locked}}"
  scroll-y="{{!compact && !locked}}"
  enhanced
  show-scrollbar="{{false}}"
  scroll-left="{{scrollLeft}}"
  scroll-top="{{scrollTop}}"
  bindscroll="handleScroll"
  style="height: {{viewportHeight}}px; width: {{viewportSize}}px;"
>
  <canvas
    id="beadCanvas"
    type="2d"
    bindtap="handleTap"
    bindtouchstart="handleTouchStart"
    bindtouchmove="handleTouchMove"
    bindtouchend="handleTouchEnd"
    bindtouchcancel="handleTouchEnd"
    class="bead-canvas {{gestureActive ? 'gesture-active' : ''}}"
    style="width: {{canvasWidth}}px; height: {{canvasHeight}}px; transform: scale({{gestureScale}});"
  />
</scroll-view>
