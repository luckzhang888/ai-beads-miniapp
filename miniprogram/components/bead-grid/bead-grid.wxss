.grid-scroll,
.grid-movable-area {
  width: 100%;
  overflow: hidden;
  border: 1rpx solid #e5e7eb;
  border-radius: 18rpx;
  background: #ffffff;
}

.grid-scroll.compact {
  border: 0;
  border-radius: 0;
  background: linear-gradient(145deg, #f4effc, #edf9f6);
}

canvas {
  display: block;
}

.grid-movable-view {
  overflow: visible;
}

.render-canvas {
  position: fixed;
  left: -10000px;
  top: -10000px;
  pointer-events: none;
}

.grid-image {
  display: block;
}

.grid-rendering {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: #8c8394;
  background: linear-gradient(145deg, #f7f5fa, #eef6f4);
  font-size: 22rpx;
}
