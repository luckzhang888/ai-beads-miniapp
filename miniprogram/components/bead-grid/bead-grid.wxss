.grid-scroll {
  width: 100%;
  overflow: hidden;
  border: 1rpx solid #e5e7eb;
  border-radius: 18rpx;
  background: #ffffff;
}

.grid-scroll.compact {
  border: 0;
  border-radius: 0;
  background: linear-gradient(145deg, #f4effc, #edf9f6);
}

canvas {
  display: block;
  transform-origin: center center;
}

.bead-canvas.gesture-active {
  will-change: transform;
}
