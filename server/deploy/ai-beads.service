[Unit]
Description=AI Beads DeepSeek vision API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=luck
Group=luck
WorkingDirectory=/home/luck/ai-beads-server
Environment=NODE_ENV=production
ExecStart=/usr/bin/node -r dotenv/config src/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
